<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RomM.Client\RomM.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Native-AOT / trim safe (transitively pulls the AOT-safe RomM.Client 1.0.1). -->
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>RomM.Client.Csdb</PackageId>
    <Version>1.0.1</Version>
    <Description>Client-side CSDb search and Structure A library ingest for RomM (Native-AOT / trim safe)</Description>
    <Authors>RomM-GB64</Authors>
  </PropertyGroup>

</Project>
