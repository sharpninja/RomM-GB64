vider for expiry skew tests.</summary>\r\n336: internal sealed class FakeTimeProvider : TimeProvider\r\n337: {\r\n338:     private readonly DateTimeOffset _utcNow;\r\n339: \r\n340:     public FakeTimeProvider(DateTimeOffset utcNow)\r\n341:     {\r\n342:         _utcNow = utcNow;\r\n343:     }\r\n344: \r\n345:     public override DateTimeOffset GetUtcNow() => _utcNow;\r\n346: }\r\n\u001b[1m==> tests\\RomM.Client.Tests\\RomMHttpExceptionMappingTests.cs <==\u001b[0m\r\n  1: using System.Net;\r\n  2: using RomM.Client.Auth;\r\n  3: using RomM.Client.Http;\r\n  4: \r\n  5: namespace RomM.Client.Tests;\r\n  6: \r\n  7: /// <summary>TEST-AUTH / TR-ERR-001: 401 and 403 map to typed exceptions; secrets stay out of messages.</summary>\r\n  8: public sealed class RomMHttpExceptionMappingTests\r\n  9: {\r\n 10:     [Fact]\r\n 11:     public async Task EnsureSuccess_maps_401_to_RomMAuthException()\r\n 12:     {\r\n 13:         using var http = new HttpClient(new FixedStatusHandler(HttpStatusCode.Unauthorized, \"{\\\"error\\\":\\\"nope\\\"}\"))\r\n 14:         {\r\n 15:             BaseAddress = new Uri(\"http://romm.test/\"),\r\n 16:         };\r\n 17: \r\n 18:         using var response = await http.GetAsync(\"/api/platforms\");\r\n 19:         var ex = await Assert.ThrowsAsync<RomMAuthException>(\r\n 20:             () => RomMHttp.EnsureSuccessOrThrowAsync(response));\r\n 21: \r\n 22:         Assert.Equal(401, ex.StatusCode);\r\n 23:         Assert.Equal(\"/api/platforms\", ex.Path);\r\n 24:         Assert.Contains(\"nope\", ex.ResponseBody, StringComparison.Ordinal);\r\n 25:         Assert.IsAssignableFrom<RomMApiException>(ex);\r\n 26:     }\r\n 27: \r\n 28:     [Fact]\r\n 29:     public async Task EnsureSuccess_maps_403_to_RomMForbiddenException()\r\n 30:     {\r\n 31:         using var http = new HttpClient(new FixedStatusHandler(HttpStatusCode.Forbidden, \"{\\\"error\\\":\\\"denied\\\"}\"))\r\n 32:         {\r\n 33:             BaseAddress = new Uri(\"http://romm.test/\")