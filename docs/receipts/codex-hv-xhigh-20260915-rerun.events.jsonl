{"type":"item.started","item":{"id":"item_21","type":"mcp_tool_call","server":"powershell","tool":"execute_command","arguments":{"pipeline":"Add-LinesToFile (Join-Path $script:hvRoot 'Program.cs') -Content $var1 | Out-Null\n@{tool_name='Edit';tool_input=@{file_path=(Join-Path $script:hvRoot 'Program.cs')}} | ConvertTo-Json -Compress | & 'C:\\Users\\kingd\\.codex\\plugins\\cache\\mcpserver-codex-plugin\\mcpserver\\1.106.0\\lib\\code-verify.ps1'\nGet-FileHash (Join-Path $script:hvRoot 'Program.cs')\ndotnet run --project (Join-Path $script:hvRoot 'HvProbes.csproj') -c Release --property:OutputType=Exe 2>&1 | Tee-Object -FilePath (Join-Path $script:hvRoot 'independent-probes.log')\n$script:hvProbeExit = $LASTEXITCODE\nWrite-Output ('ProbeExit=' + $script:hvProbeExit)","var1":"using System.Net;\nusing System.Text;\nusing System.Text.Json;\nusing RomM.Client;\nusing RomM.Client.Auth;\nusing RomM.Client.Models;\n\ninternal static class Program\n{\n    static readonly Uri Origin = new(\"http://romm.test/\");\n    static readonly List<object> Results = new();\n    static int Passed, Failed;\n    static void Check(bool condition, string reason) { if (!condition) throw new Exception(reason); }\n    static HttpResponseMessage Json(string body, HttpStatusCode code = HttpStatusCode.OK)\n        => new(code) { Content = new StringContent(body, Encoding.UTF8, \"application/json\") };\n    static async Task Probe(string id, Func<Task> action)\n    {\n        try { await action(); Passed++; Results.Add(new { id, result = \"PASS\" }); Console.WriteLine(\"PASS \" + id); }\n        catch (Exception ex) { Failed++; Results.Add(new { id, result = \"FAIL\", error = ex.ToString() }); Console.WriteLine(\"FAIL \" + id + \": \" + ex); }\n    }\n    static RomMAuth Auth(string kind) => kind switch {\n        \"Bearer\" => RomMAuth.ClientApiToken(\"rmm_hv_dummy\"),\n        \"Basic\" => RomMAuth.Basic(\"hv_dummy_user\", \"hv_dummy_password\"),\n        _ => RomMAuth.OAuthPassword(\"hv_dummy_user\", \"hv_dummy_password\")\n    };\n    static string Expected(string kind) => kind switch {\n        \"Bearer\" => \"Bearer rmm_hv_dummy\",\n        \"Basic\" => \"Basic \" + Convert.ToBase64String(Encoding.UTF8.GetBytes(\"hv_dummy_user:hv_dummy_password\")),\n        _ => \"Bearer hv_dummy_oauth\"\n    };\n    static void NoCredentials(Seen s)\n    {\n        Check(s.Authorization is null, \"Credential header on \" + s.Url);\n        Check(s.Method == \"GET\" && s.Body is null, \"Unexpected method/body on \" + s.Url);\n    }\n    static async Task DefaultTransport()\n    {\n        var wire = new Capture();\n        using var http = new HttpClient(new RomMAuthHandler(Auth(\"Bearer\")) { InnerHandler = wire }) { BaseAddress = Origin };\n        await using var transport = new RomMTransport(http);\n        using var foreign = await transport.SendAsync(HttpMethod.Get, \"https://evil.example/api/roms\");\n        Check(wire.Seen.Count == 1 && wire.Seen[0].Url == \"https://evil.example/api/roms\", \"Exact foreign repro not sent\");\n        NoCredentials(wire.Seen[0]);\n        using var relative = await transport.SendAsync(HttpMethod.Get, \"api/platforms\");\n        Check(wire.Seen.Count == 2, \"Unexpected request count\");\n        Check(wire.Seen[1].Url == \"http://romm.test/api/platforms\", \"Relative resolution wrong\");\n        Check(wire.Seen[1].Authorization == Expected(\"Bearer\"), \"Positive control lacks exact Bearer\");\n        Check(wire.Seen.All(s => s.Inherited == Origin.AbsoluteUri), \"Transport did not stamp inherited base\");\n        Console.WriteLine(\"  default same-handler: foreign auth=null; relative auth=Bearer; inherited=http://romm.test/; requests=2\");\n    }\n    static async Task OriginIsolation(string kind, bool factory)\n    {\n        var wire = new Capture();\n        HttpClient? http = null;\n        RomMClient? client = null;\n        IRomMTransport transport;\n        if (factory) { client = RomMClient.Create(Origin, Auth(kind), wire); transport = client.Transport; }\n        else {\n            http = new HttpClient(new RomMAuthHandler(Auth(kind)) { InnerHandler = wire }) { BaseAddress = Origin };\n            transport = new RomMTransport(http);\n        }\n        try {\n            foreach (var url in new[] { \"https://evil.example/api/roms\", \"http://evil.example/api/roms\",\n                \"https://romm.test/api/roms\", \"http://romm.test:8080/api/roms\" }) {\n                int start = wire.Seen.Count;\n                using var response = await transport.SendAsync(HttpMethod.Get, url);\n                Check(wire.Seen.Count == start + 1 && wire.Seen[^1].Url == url, \"Cold foreign request emitted extra requests\");\n                NoCredentials(wire.Seen[^1]);\n            }\n            using var allowed = await transport.SendAsync(HttpMethod.Get, \"api/platforms\");\n            Check(wire.Seen[^1].Url == \"http://romm.test/api/platforms\" && wire.Seen[^1].Authorization == Expected(kind), \"Allowed origin lost credentials\");\n            if (kind == \"OAuth\") {\n                var posts = wire.Seen.Where(s => s.Method == \"POST\").ToArray();\n                Check(posts.Length == 1 && posts[0].Url == \"http://romm.test/api/token\", \"OAuth endpoint not pinned\");\n                Check(posts[0].Body!.Contains(\"username=hv_dummy_user\") && posts[0].Body.Contains(\"password=hv_dummy_password\"), \"OAuth positive control missing password form\");\n            }\n            int before = wire.Seen.Count;\n            using var warm = await transport.SendAsync(HttpMethod.Get, \"https://evil.example/api/roms\");\n            Check(wire.Seen.Count == before + 1, \"Warm foreign request triggered token POST\");\n            NoCredentials(wire.Seen[^1]);\n            Check(!wire.Seen.Any(s => new Uri(s.Url).Host == \"evil.example\" && (s.Method == \"POST\" || s.Authorization != null || s.Body != null)), \"Foreign credential leak\");\n            Console.WriteLine($\"  {kind}, factory={factory}: cold foreign host/scheme/port blocked; same-origin authenticated; cached foreign blocked; requests={wire.Seen.Count}\");\n        } finally { if (client != null) await client.DisposeAsync(); http?.Dispose(); }\n    }\n    static async Task NullOrigin(string kind, bool clientBase)\n    {\n        var wire = new Capture();\n        using var http = new HttpClient(new RomMAuthHandler(Auth(kind)) { InnerHandler = wire });\n        if (clientBase) http.BaseAddress = Origin;\n        using var response = await http.GetAsync(\"http://romm.test/api/platforms\");\n        Check(wire.Seen.Count == 1 && wire.Seen[0].Inherited is null, \"Unexpected inherited options or token request\");\n        NoCredentials(wire.Seen[0]);\n    }\n    static async Task Heartbeat(bool? setup)\n    {\n        string body = setup.HasValue\n            ? JsonSerializer.Serialize(new { SYSTEM = new { VERSION = \"5.0.0-hv\", SHOW_SETUP_WIZARD = setup.Value } })\n            : \"\"\"{\"VERSION\":\"wrong-top-level\",\"SHOW_SETUP_WIZARD\":true}\"\"\";\n        var wire = new Capture(_ => Json(body));\n        await using var client = RomMClient.Create(Origin, handler: wire);\n        var result = await client.System.GetHeartbeatAsync();\n        Check(result.Version == (setup.HasValue ? \"5.0.0-hv\" : null) && result.ShowSetupWizard == setup, \"SYSTEM mapping mismatch\");\n        Check(wire.Seen.Single().Url == \"http://romm.test/api/heartbeat\", \"Wrong heartbeat route\");\n    }\n    static int QueryInt(Seen s, string key) => int.Parse(new Uri(s.Url).Query.TrimStart('?').Split('&').Single(x => x.StartsWith(key + \"=\")).Split('=')[1]);\n    static async Task Pagination(int count, int limit, bool includeTotal)\n    {\n        var wire = new Capture(s => {\n            Check(s.Method == \"GET\" && new Uri(s.Url).AbsolutePath == \"/api/roms\", \"Wrong pagination route\");\n            int offset = QueryInt(s, \"offset\");\n            Check(QueryInt(s, \"limit\") == limit, \"Page limit changed\");\n            var page = new Dictionary<string, object> {\n                [\"items\"] = Enumerable.Range(1, count).Skip(offset).Take(limit).Select(id => new { id }).ToArray(),\n                [\"limit\"] = limit, [\"offset\"] = offset\n            };\n            if (includeTotal) page[\"total\"] = count;\n            return Json(JsonSerializer.Serialize(page));\n        });\n        await using var client = RomMClient.Create(Origin, handler: wire);\n        var ids = new List<int>();\n        await foreach (var item in client.Roms.EnumerateAsync(new RomListQuery { Limit = limit })) {\n            ids.Add(item.Id); Check(ids.Count <= count, \"Infinite/duplicate enumeration\");\n        }\n        Check(ids.SequenceEqual(Enumerable.Range(1, count)), \"Missing or reordered ROMs\");\n        int calls = includeTotal ? (count + limit - 1) / limit : count / limit + 1;\n        Check(wire.Seen.Count == calls, \"Unexpected page requests\");\n        Check(wire.Seen.Select(s => QueryInt(s, \"offset\")).SequenceEqual(Enumerable.Range(0, calls).Select(i => i * limit)), \"Wrong offsets\");\n        Console.WriteLine($\"  pagination total={(includeTotal ? count.ToString() : \"omitted\")}: IDs={string.Join(\",\", ids)}; offsets={string.Join(\",\", wire.Seen.Select(s => QueryInt(s, \"offset\")))}\");\n    }\n    static async Task Cancellation(int pageSize, bool cancelFirst)\n    {\n        var wire = new Capture(_ => Json(JsonSerializer.Serialize(new {\n            items = Enumerable.Range(1, pageSize).Select(id => new { id }).ToArray(), total = 5, limit = pageSize, offset = 0\n        })));\n        await using var client = RomMClient.Create(Origin, handler: wire);\n        using var cts = new CancellationTokenSource();\n        if (cancelFirst) cts.Cancel();\n        int count = 0; bool canceled = false;\n        try {\n            await foreach (var item in client.Roms.EnumerateAsync(new RomListQuery { Limit = pageSize }, cts.Token)) {\n                count++; cts.Cancel();\n            }\n        } catch (OperationCanceledException) { canceled = true; }\n        Check(canceled && count == (cancelFirst ? 0 : 1) && wire.Seen.Count == (cancelFirst ? 0 : 1), \"Yield/request after cancellation\");\n    }\n    static async Task RomDetail()\n    {\n        const string missing = \"\"\"{\"detail\":\"hv missing\"}\"\"\";\n        var wire = new Capture(s => new Uri(s.Url).AbsolutePath == \"/api/roms/71\"\n            ? Json(\"\"\"{\"id\":71,\"name\":\"HV ROM\",\"summary\":\"HV summary\",\"fs_name\":\"hv.zip\",\"slug\":\"hv-rom\"}\"\"\")\n            : Json(missing, HttpStatusCode.NotFound));\n        await using var client = RomMClient.Create(Origin, handler: wire);\n        var rom = await client.Roms.GetAsync(71);\n        Check(rom.Id == 71 && rom.Name == \"HV ROM\" && rom.Summary == \"HV summary\" && rom.FsName == \"hv.zip\" && rom.Slug == \"hv-rom\", \"ROM detail mismatch\");\n        RomMApiException? error = null;\n        try { await client.Roms.GetAsync(404); } catch (RomMApiException ex) { error = ex; }\n        Check(error is { StatusCode: 404, Path: \"/api/roms/404\", ResponseBody: missing }, \"404 status/path/body lost\");\n        Check(wire.Seen.Count == 2, \"Unexpected detail requests\");\n    }\n    static async Task TaskStatus(string status)\n    {\n        string body = JsonSerializer.Serialize(new {\n            task_name = \"hv_task\", task_id = \"hv-job\", status, created_at = (string?)null, enqueued_at = (string?)null,\n            started_at = (string?)null, ended_at = (string?)null, task_type = \"generic\", meta = new { }\n        });\n        var wire = new Capture(s => {\n            Check(s.Url == \"http://romm.test/api/tasks/hv-job\" && s.Method == \"GET\", \"Wrong task route/fallback\");\n            return Json(body);\n        });\n        await using var client = RomMClient.Create(Origin, handler: wire);\n        var value = await client.Tasks.GetStatusAsync(\"hv-job\");\n        Check(value.TaskId == \"